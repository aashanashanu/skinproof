aws_region        = "us-east-1"
github_repository = "OWNER/REPOSITORY"
github_owner       = "OWNER"
github_owner_id    = "OWNER_ID"
github_name        = "REPOSITORY"
github_repository_id = "REPOSITORY_ID"
github_branch     = "main"
github_environment = "main"
instance_type     = "t3.small"
budget_alert_email = "your-email@example.com"
enable_ec2_schedule = false
ec2_schedule_timezone = "America/Chicago"
ec2_start_schedule = "cron(0 10 * * ? *)"
ec2_backup_schedule = "cron(0 22 * * ? *)"
ec2_stop_schedule = "cron(0 0 * * ? *)"